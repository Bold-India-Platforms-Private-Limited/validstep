# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment
.env.*
# .env holds only public API/socket URLs (no secrets), always pointed at the production
# API — the same values are used in local dev and in the build, so it's committed instead
# of gitignored like a normal .env would be.
!.env

